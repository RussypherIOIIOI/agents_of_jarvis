# Copy to .env and fill in. Never commit .env.
# The app runs without any of these using an offline stub, but real answers
# require a model provider.

# ---- Option 1: Claude (Anthropic) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...

# ---- Option 2: Local Ollama (free, offline). Install from https://ollama.com ----
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# ---- Tuning (optional) ----
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
